# Add these environment variables in your production .env file for the backend
DATABASE_URL=postgresql://username:password@db_host:5432/netflix_clone
JWT_SECRET=your-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PAYMENT_PROVIDER_KEY=your-payment-api-key
ALLOWED_ORIGINS=http://localhost,https://yourfrontend.com
STORAGE_BUCKET_URL=https://storage.example.com/videos
